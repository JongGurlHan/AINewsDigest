# 이 파일을 .env로 복사한 뒤 실제 값을 채운다.
#   cp .env.example .env
#
# .env는 .gitignore에 있다. 실제 키·토큰을 이 파일(.env.example)에 적지 말 것 —
# 커밋되는 파일이라 적는 순간 유출이다. 여기에는 플레이스홀더만 둔다.
#
# 운영 서버에서는 권한을 좁힌다:  chmod 600 .env

# --- 도메인 (운영 전용) ---------------------------------------------------
# docker-compose.prod.yml의 Caddy가 읽는 사이트 주소. 이 도메인의 A 레코드가
# 서버의 예약 공인 IP를 가리켜야 인증서가 발급된다. 로컬에서는 비워 둔다.
# 자세한 절차는 docs/DEPLOY.md 참조.
DOMAIN=

# --- 데이터베이스 ---------------------------------------------------------
# compose로 띄우면 호스트는 서비스명 db다. 외부 DB를 쓸 때만 이 값을 바꾼다.
DB_URL=jdbc:postgresql://db:5432/ainewsdigest
DB_USER=postgres
DB_PASSWORD=change-me

# --- OpenAI (선별·요약) ---------------------------------------------------
# https://platform.openai.com/api-keys 에서 발급한다.
# 비어 있으면 07:00 생성 배치가 실패한다.
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx

# --- 텔레그램 -------------------------------------------------------------
# @BotFather에서 봇을 만들면 받는 토큰. 유출되면 봇을 탈취당해
# 구독자 전원에게 임의의 메시지가 나간다.
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 랜딩의 구독 버튼이 걸리는 딥링크 대상(@ 없이). 공개값이다.
TELEGRAM_BOT_USERNAME=ainewsdigest_bot
# 배치 실패 알림을 받을 관리자 chat_id. 봇에게 /start를 보낸 뒤 확인한다.
# 비워 두면 관리자 알림을 보내지 않는다(앱은 정상 동작한다).
ADMIN_CHAT_ID=123456789

# --- 데드맨스위치 (ADR-010) -----------------------------------------------
# 발송 성공 시에만 GET 하는 https://healthchecks.io 핑 URL.
# 비워 두면 핑을 보내지 않는다. "뉴스 없음"이 정상 동작이라 침묵과 장애가
# 구분되지 않으므로, 이 역방향 감시가 있어야 앱이 죽은 날을 알 수 있다.
HEALTHCHECK_URL=https://hc-ping.com/00000000-0000-0000-0000-000000000000
